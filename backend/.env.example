# DATABASE_URL은 `npm run dev`(또는 `npm run db:start`) 실행 시
# scripts/setup-db.js 가 `prisma dev` 로컬 DB를 띄우고 자동으로 채워줍니다.
# 별도 Postgres 설치가 필요 없습니다. 직접 값을 넣지 않아도 됩니다.
DATABASE_URL=

# 임의의 랜덤 문자열. 비어 있으면 setup-db.js가 자동 생성합니다.
JWT_SECRET=

# https://www.last.fm/api/account/create 에서 무료 발급.
# 없어도 서버는 뜨지만, 곡 아카이브 시 자동 장르 태깅 기능은 동작하지 않습니다.
Lastfm_API_KEY=
